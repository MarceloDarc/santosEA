# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# Material bruto do site — vídeo estoura o limite de 100MB por arquivo do
# GitHub (o da Mercedes tem 185MB). Fica só local; o que for pro site vai
# comprimido e otimizado depois.
site/fotos/videos/
*.mp4
*.mov
# ...mas os vídeos já comprimidos e otimizados que fazem parte do site entram
!site/assets/*.mp4
